# Cache e bytecode do Python
__pycache__/
*.py[cod]

# Ambientes virtuais
.venv/
venv/
env/

# Configuracoes locais e credenciais (exemplos podem ser versionados)
.env
.env.*
!.env.example
!.env.*.example
/.aws/
*.key
*.pem

# Logs e capturas de rede gerados durante os testes
*.log
*.pcap
*.pcapng

# Evidencias didaticas da Fase 2, somente com contas de teste.
!docs/evidencias/fase2/*.pcap

# Arquivos temporarios do sistema e dos editores
.DS_Store
Thumbs.db
*.swp
*.swo
*~
